# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/qa/.results
/.next-live/
/qa/.results-live

# QA run output (screenshots, logs, sweep results, seed pointer)
/qa/screenshots/
/qa/screenshots-live/
/qa/independent/shots/
/qa/independent/*.log
/qa/independent/.seed
/qa/independent/sweep*.json
/qa/independent/copy-strings*.json
